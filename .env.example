# Copy to .env and fill in real values. Never commit .env.
PORT=5001
JWT_SECRET=replace-with-a-long-random-string

# Database: either a full URL ...
# DATABASE_URL=postgres://user:password@host:5432/postgres
# ... or the individual parts (Supabase pooler example: port 6543)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-db-user
DB_PASSWORD=your-db-password
# Set to false for a local PostgreSQL server without SSL
DB_SSL=true

# Local development without PostgreSQL (comment out the DB_* lines above):
# DB_DIALECT=sqlite
# DB_STORAGE=dev.sqlite

# Comma-separated emails that are allowed to sign up as admin
ADMIN_EMAILS=admin@example.com
# Comma-separated allowed browser origins (leave empty to allow all in development)
CORS_ORIGIN=http://localhost:3000
